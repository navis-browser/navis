{
  "schema_version": 1,
  "profile": "desktop-embedder-core",
  "description": "Executable capability and dependency contract for the Navis Desktop Gecko Embedder runtime.",
  "profiles": {
    "desktop-embedder-core": {
      "description": "Default Navis 1.0 browsing profile without product observability, real media capture, PeerConnection, data channels, or native libwebrtc."
    },
    "desktop-embedder-core-esr140": {
      "description": "General-browsing profile on ESR 140, whose release channel compiles JPEG XL out upstream.",
      "overrides": {
        "jpeg-xl-image-decoding": {
          "state": "excluded",
          "contract": "JPEG XL image decoding is absent because upstream ESR 140 restricts its decoder to Nightly builds.",
          "checks": {
            "config": {
              "MOZ_JXL": false
            },
            "graph_forbidden": [
              "^image/rust/jxl/"
            ]
          }
        }
      }
    },
    "desktop-embedder-core-esr140-no-observability": {
      "description": "ESR 140 general-browsing profile with the Glean/FOG, DAP, and Gecko Trace runtime integrations removed.",
      "inherits": "desktop-embedder-core-esr140",
      "overrides": {
        "observability-runtime": {
          "state": "excluded",
          "contract": "No executable observability collector, store, archive, or submission pipeline is present; only constant-off ABI and process-clock compatibility surfaces remain."
        }
      }
    },
    "desktop-embedder-minimal-no-webrtc": {
      "description": "Experimental general-media profile without real camera/microphone capture, PeerConnection, data channels, or native libwebrtc.",
      "overrides": {
        "media-capture": {
          "state": "excluded",
          "contract": "Real camera/microphone capture and its product permission/indicator actors are absent; the nonfunctional web entry point is locked off.",
          "checks": {
            "config": {
              "MOZ_WEBRTC": false
            },
            "omni_forbidden": [
              "^modules/DesktopEmbedderBrowserProcessChild\\.sys\\.mjs$",
              "^modules/DesktopEmbedderWebRTC(Child|Parent)\\.sys\\.mjs$"
            ],
            "omni_content_required": {
              "defaults/pref/navis.js": [
                "pref\\(\"media\\.navigator\\.enabled\", false, locked\\);",
                "pref\\(\"media\\.peerconnection\\.enabled\", false, locked\\);"
              ]
            },
            "omni_content_forbidden": {
              "defaults/pref/navis.js": [
                "^#ifn?def MOZ_WEBRTC$"
              ]
            }
          }
        },
        "webrtc-peer-connection": {
          "state": "excluded",
          "contract": "RTCPeerConnection, WebRTC signaling/data channels, and native libwebrtc are absent.",
          "checks": {
            "config": {
              "MOZ_WEBRTC": false
            },
            "graph_forbidden": [
              "^media/webrtc/",
              "^third_party/libwebrtc/"
            ],
            "generated_required": {
              "dom/media/webrtc/Unified_cpp_dom_media_webrtc0.cpp": [
                "MediaEngineFake\\.cpp",
                "MediaEngineSource\\.cpp",
                "MediaTrackConstraints\\.cpp"
              ]
            },
            "generated_forbidden": {
              "dom/media/webrtc/Unified_cpp_dom_media_webrtc0.cpp": [
                "MediaEngineRemoteVideoSource\\.cpp",
                "MediaEngineWebRTCAudio\\.cpp",
                "RTCCertificate\\.cpp",
                "RTCIdentityProviderRegistrar\\.cpp",
                "PWebrtcGlobal(Child|Parent)?\\.cpp"
              ]
            }
          }
        }
      }
    },
    "desktop-embedder-controlled-content": {
      "description": "Experimental controlled-content profile without real-time communication or JPEG XL decoding.",
      "overrides": {
        "jpeg-xl-image-decoding": {
          "state": "excluded",
          "contract": "JPEG XL image decoding is absent even when content enables the otherwise opt-in preference.",
          "checks": {
            "config": {
              "MOZ_JXL": false
            },
            "graph_forbidden": [
              "^image/rust/jxl/"
            ]
          }
        },
        "media-capture": {
          "state": "excluded",
          "contract": "Real camera/microphone capture and its product permission/indicator actors are absent; the nonfunctional web entry point is locked off.",
          "checks": {
            "config": {
              "MOZ_WEBRTC": false
            },
            "omni_forbidden": [
              "^modules/DesktopEmbedderBrowserProcessChild\\.sys\\.mjs$",
              "^modules/DesktopEmbedderWebRTC(Child|Parent)\\.sys\\.mjs$"
            ],
            "omni_content_required": {
              "defaults/pref/navis.js": [
                "pref\\(\"media\\.navigator\\.enabled\", false, locked\\);",
                "pref\\(\"media\\.peerconnection\\.enabled\", false, locked\\);"
              ]
            },
            "omni_content_forbidden": {
              "defaults/pref/navis.js": [
                "^#ifn?def MOZ_WEBRTC$"
              ]
            }
          }
        },
        "webrtc-peer-connection": {
          "state": "excluded",
          "contract": "RTCPeerConnection, WebRTC signaling/data channels, and native libwebrtc are absent.",
          "checks": {
            "config": {
              "MOZ_WEBRTC": false
            },
            "graph_forbidden": [
              "^media/webrtc/",
              "^third_party/libwebrtc/"
            ],
            "generated_required": {
              "dom/media/webrtc/Unified_cpp_dom_media_webrtc0.cpp": [
                "MediaEngineFake\\.cpp",
                "MediaEngineSource\\.cpp",
                "MediaTrackConstraints\\.cpp"
              ]
            },
            "generated_forbidden": {
              "dom/media/webrtc/Unified_cpp_dom_media_webrtc0.cpp": [
                "MediaEngineRemoteVideoSource\\.cpp",
                "MediaEngineWebRTCAudio\\.cpp",
                "RTCCertificate\\.cpp",
                "RTCIdentityProviderRegistrar\\.cpp",
                "PWebrtcGlobal(Child|Parent)?\\.cpp"
              ]
            }
          }
        }
      }
    },
    "desktop-embedder-controlled-content-no-observability": {
      "description": "Controlled-content profile with the Glean/FOG, DAP, and Gecko Trace runtime integrations removed.",
      "inherits": "desktop-embedder-controlled-content",
      "overrides": {
        "observability-runtime": {
          "state": "excluded",
          "contract": "No executable observability collector, store, archive, or submission pipeline is present; only constant-off ABI and process-clock compatibility surfaces remain."
        }
      }
    }
  },
  "states": {
    "required": "Part of the published web/embedder contract and must stay in the graph.",
    "retained-substrate": "Not a product capability, but retained because Gecko core consumes its policy or security substrate.",
    "excluded": "Outside the runtime contract and required to be absent from the build or package checks listed here.",
    "candidate": "A reviewed removal candidate; no absence claim is made yet.",
    "deferred": "Required eventually, but the listed platform evidence is not complete."
  },
  "capabilities": [
    {
      "id": "desktop-embedder-api",
      "classification": "embedder-boundary",
      "state": "required",
      "contract": "Runtime, Session, live attachable View and bounded Delegate APIs with no Gecko objects crossing into products.",
      "checks": {
        "config": {
          "MOZ_DESKTOP_EMBEDDER": true
        },
        "graph_required": [
          "^desktop-embedder/",
          "^navis/"
        ],
        "omni_required": [
          "modules/DesktopEngine.sys.mjs",
          "modules/DesktopDevTools.sys.mjs",
          "modules/DesktopEmbedderStartup.sys.mjs"
        ],
        "omni_content_required": {
          "modules/DesktopEngine.sys.mjs": [
            "^export const DESKTOP_EMBEDDER_API_VERSION = 2;$",
            "^export class EngineRuntime \\{$",
            "^export class EngineSession \\{$",
            "^export class EngineView \\{$",
            "^  get windowCount\\(\\) \\{$",
            "^  get session\\(\\) \\{$",
            "^  attach\\(session\\) \\{$",
            "^  detach\\(\\) \\{$",
            "^  stop\\(\\) \\{$",
            "^  get visible\\(\\) \\{$",
            "^  get focused\\(\\) \\{$",
            "^  get bounds\\(\\) \\{$",
            "^  focus\\(\\) \\{$",
            "^  blur\\(\\) \\{$",
            "jpegXL: AppConstants\\.MOZ_JXL",
            "source API 2 requires an explicit EngineView",
            "\\.swapDocShells\\(sourceBrowser\\)",
            "#cancelAllPrompts\\(\"session-closed\"\\)[\\s\\S]*?#syncNavigationState\\(\\{[\\s\\S]*?closed: true[\\s\\S]*?#destroyBrowser\\(\\)",
            "\\bonSessionCreated\\b",
            "permanentKey = new \\(Cu\\.getGlobalForObject\\(Services\\)\\.Object\\)\\(\\)",
            "destinationBrowser\\.permanentKey = sourcePermanentKey"
          ]
        },
        "omni_content_forbidden": {
          "modules/DesktopEngine.sys.mjs": [
            "^export class Engine(Runtime|Session) extends EventTarget",
            "^  respondToPrompt\\("
          ]
        }
      }
    },
    {
      "id": "desktop-page-developer-tools",
      "classification": "product-capability",
      "state": "required",
      "contract": "F12, the application menu and a page-context Inspect command expose Gecko's full page-target developer-tool client, server and protocol through a Core-private adapter. Browser Toolbox and privileged parent-process debugging are not exposed by these commands.",
      "checks": {
        "config": {
          "MOZ_DESKTOP_EMBEDDER_DEVTOOLS": true,
          "MOZ_DEVTOOLS": "all"
        },
        "graph_required": [
          "^devtools/client/",
          "^devtools/platform/",
          "^devtools/server/",
          "^devtools/shared/",
          "^devtools/startup/"
        ],
        "omni_required": [
          "chrome/devtools/content/framework/toolbox.xhtml",
          "chrome/devtools/content/inspector/index.xhtml",
          "chrome/devtools/content/webconsole/index.html",
          "chrome/devtools-startup/content/DevToolsShim.sys.mjs",
          "chrome/toolkit/content/global/viewSourceUtils.js",
          "defaults/pref/debugger.js",
          "defaults/pref/navis-devtools.js",
          "modules/DesktopContextMenuChild.sys.mjs",
          "modules/DesktopDevTools.sys.mjs"
        ],
        "omni_content_required": {
          "modules/DevToolsStartup.sys.mjs": [
            "if \\(AppConstants\\.MOZ_DESKTOP_EMBEDDER_DEVTOOLS\\) \\{[\\s\\S]*?JsonView\\.initialize\\(\\);[\\s\\S]*?return;[\\s\\S]*?this\\.hookWindow\\(window\\)"
          ],
          "defaults/pref/navis-devtools.js": [
            "pref\\(\"devtools\\.chrome\\.enabled\", false, locked\\);",
            "pref\\(\"devtools\\.debugger\\.remote-enabled\", false, locked\\);",
            "pref\\(\"devtools\\.toolbox\\.footer\\.height\", 250\\);",
            "pref\\(\"devtools\\.toolbox\\.zoomValue\", \"1\"\\);",
            "pref\\(\"devtools\\.inspector\\.enabled\", true\\);",
            "pref\\(\"devtools\\.netmonitor\\.enabled\", true\\);",
            "pref\\(\"devtools\\.webconsole\\.input\\.autocomplete\", true\\);",
            "pref\\(\"devtools\\.responsive\\.viewport\\.width\", 320\\);"
          ],
          "modules/DesktopDevTools.sys.mjs": [
            "DevToolsServer\\.chromeWindowType = \"navis:browser\"",
            "gDevTools\\.chromeWindowType = \"navis:browser\"",
            "async inspect\\(session, domReference\\)",
            "gDevTools\\.inspectNode\\(tab, domReference, ChromeUtils\\.now\\(\\)\\)"
          ],
          "modules/DesktopEngine.sys.mjs": [
            "developerTools: AppConstants\\.MOZ_DESKTOP_EMBEDDER_DEVTOOLS",
            "async toggleDeveloperTools\\(session, options = undefined\\)",
            "async closeDeveloperTools\\(session\\)",
            "\"inspect-element\": \"developer\"",
            "INSPECT_CONTEXT_TARGET"
          ],
          "modules/DesktopContextMenuChild.sys.mjs": [
            "ContentDOMReference\\.get\\(target\\)",
            "command\\(\"inspect-element\", \"developer\"\\)"
          ],
          "chrome/navis/content/main.mjs": [
            "for \\(const \\{ element, toolId \\} of developerToolsShortcutBindings\\) \\{[\\s\\S]*?element\\.addEventListener\\(\"command\"[\\s\\S]*?toggleActiveDeveloperTools\\(toolId\\)",
            "\\.toggleDeveloperTools\\(activeRecord\\.session, options\\)",
            "menuDeveloperTools\\.addEventListener\\(\"click\"[\\s\\S]*?toggleActiveDeveloperTools\\(\\)",
            "\"inspect-element\""
          ],
          "chrome/navis/content/main.xhtml": [
            "<xul:key id=\"navis-toggle-devtools-key\" keycode=\"VK_F12\" />",
            "id=\"menu-developer-tools\"[\\s\\S]*?data-l10n-aria-label=\"menu\\.developerTools\""
          ],
          "chrome/navis/content/main.css": [
            "--browser-stack-z-index-devtools-splitter: 1;",
            "--browser-stack-z-index-dialog-stack: 2;",
            "--browser-stack-z-index-rdm-toolbar: 3;",
            "--browser-stack-z-index-screenshots-panel: 4;"
          ]
        }
      }
    },
    {
      "id": "web-platform-core",
      "classification": "runtime-core",
      "state": "required",
      "contract": "Interoperable HTML, CSS, JavaScript, DOM, layout, networking, storage and graphics remain Gecko responsibilities.",
      "checks": {
        "graph_required": [
          "^dom/",
          "^gfx/",
          "^js/src/",
          "^layout/",
          "^netwerk/"
        ],
        "omni_content_required": {
          "defaults/pref/navis.js": [
            "pref\\(\"dom\\.security\\.featurePolicy\\.header\\.enabled\", true, locked\\);",
            "pref\\(\"dom\\.security\\.featurePolicy\\.webidl\\.enabled\", true, locked\\);"
          ]
        }
      }
    },
    {
      "id": "fission-remote-content",
      "classification": "runtime-core",
      "state": "required",
      "contract": "Top-level and iframe content use Gecko's site-isolated remote process model; process details remain private.",
      "checks": {
        "graph_required": [
          "^dom/ipc/",
          "^ipc/glue/"
        ]
      }
    },
    {
      "id": "content-sandbox",
      "classification": "security-core",
      "state": "required",
      "contract": "Content processes retain Gecko's native platform sandbox; Linux uses seccomp and Win64 retains the broker/target policy compiled into xul.dll.",
      "checks": {
        "config": {
          "MOZ_SANDBOX": true
        },
        "graph_required": [
          "^security/sandbox/"
        ],
        "platform_checks": {
          "Linux": {
            "files_required": [
              "libmozsandbox.so"
            ]
          },
          "WINNT": {
            "files_required": [
              "xul.dll"
            ]
          }
        }
      }
    },
    {
      "id": "accessibility",
      "classification": "declared-web-capability",
      "state": "required",
      "contract": "Web content remains exposed through Gecko's platform accessibility implementation.",
      "checks": {
        "config": {
          "ACCESSIBILITY": true
        },
        "graph_required": [
          "^accessible/"
        ]
      }
    },
    {
      "id": "media-playback",
      "classification": "declared-web-capability",
      "state": "required",
      "contract": "Decoded AV1, H.264/AAC, VP9, Opus and Vorbis playback plus cross-process DOM fullscreen remain part of every current desktop browsing profile; Unix H.264/AAC requires an FFmpeg major supported by the selected ESR.",
      "checks": {
        "graph_required": [
          "^dom/media/",
          "^media/ffvpx/",
          "^media/libaom/",
          "^media/libdav1d/",
          "^media/libmkv/",
          "^media/libogg/",
          "^media/libopus/",
          "^media/libvpx/",
          "^media/libvorbis/",
          "^media/psshparser/"
        ],
        "omni_required": [
          "modules/DesktopFullscreenChild.sys.mjs",
          "modules/DesktopFullscreenParent.sys.mjs"
        ],
        "omni_content_required": {
          "modules/DesktopEmbedderActorRegistry.sys.mjs": [
            "registerWindowActor\\(\"DesktopFullscreen\""
          ],
          "modules/DesktopFullscreenChild.sys.mjs": [
            "handleFullscreenRequests\\(\\)",
            "MozDOMFullscreen:Request"
          ],
          "modules/DesktopFullscreenParent.sys.mjs": [
            "remoteFrameFullscreenChanged\\(",
            "remoteFrameFullscreenReverted\\("
          ]
        }
      }
    },
    {
