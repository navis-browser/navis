    {
      "id": "desktop-history",
      "classification": "embedder-service",
      "state": "required",
      "contract": "Gecko visited-link/Fission history semantics are backed by the embedder HistoryDelegate rather than Places.",
      "checks": {
        "config": {
          "MOZ_DESKTOP_EMBEDDER_HISTORY": true,
          "MOZ_PLACES": false
