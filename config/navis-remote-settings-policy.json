{
  "schema_version": 1,
  "product": "Navis 1.0",
  "provider": {
    "production_server": "https://firefox.settings.services.mozilla.com/v1",
    "default_signer": "remote-settings.content-signature.mozilla.org",
    "security_state_signer": "onecrl.content-signature.mozilla.org",
    "signature_algorithm": "p384ecdsa"
  },
  "allowed_collections": [
    {
      "identifier": "blocklists/addons",
      "packaged_bootstrap": false,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Legacy add-on block decisions for immutable application built-ins"
    },
    {
      "identifier": "blocklists/addons-bloomfilters",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Bloom-filter add-on block decisions for immutable application built-ins"
    },
    {
      "identifier": "blocklists/gfx",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Driver and device compatibility decisions for Gecko graphics, WebRender and WebGPU"
    },
    {
      "identifier": "main/moz-essential-domain-fallbacks",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Fallback mappings for the retained Remote Settings and content-signature infrastructure"
    },
    {
      "identifier": "main/password-recipes",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Site compatibility recipes used by Gecko login-form handling"
    },
    {
      "identifier": "main/password-rules",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Site-specific password-generation constraints"
    },
    {
      "identifier": "main/url-parser-default-unknown-schemes-interventions",
      "packaged_bootstrap": true,
      "signer": "remote-settings.content-signature.mozilla.org",
      "purpose": "Compatibility and parser-safety handling for known external URI schemes"
    },
    {
      "identifier": "security-state/cert-revocations",
      "packaged_bootstrap": false,
      "signer": "onecrl.content-signature.mozilla.org",
      "purpose": "CRLite certificate-revocation filters and incremental updates"
    },
    {
      "identifier": "security-state/intermediates",
      "packaged_bootstrap": true,
      "signer": "onecrl.content-signature.mozilla.org",
      "purpose": "Intermediate CA certificate preloading"
    },
    {
      "identifier": "security-state/onecrl",
      "packaged_bootstrap": true,
      "signer": "onecrl.content-signature.mozilla.org",
      "purpose": "Emergency certificate revocation state"
    }
  ],
  "excluded_source_collections": [
    "main/ai-window-prompts",
    "main/anti-tracking-url-decoration",
    "main/cookie-banner-rules-list",
    "main/devtools-compatibility-browsers",
    "main/devtools-devices",
    "main/doh-config",
    "main/doh-providers",
    "main/example",
    "main/hijack-blocklists",
    "main/language-dictionaries",
    "main/newtab-wallpapers-v2",
    "main/remote-permissions",
    "main/search-config-icons",
    "main/search-config-overrides-v2",
    "main/search-config-v2",
    "main/search-default-override-allowlist",
    "main/search-telemetry-v2",
    "main/sites-classification",
    "main/top-sites",
    "main/translations-models",
    "main/translations-wasm",
    "main/url-classifier-skip-urls",
    "main/urlbar-persisted-search-terms",
    "main/websites-with-shared-credential-backends"
  ]
}
